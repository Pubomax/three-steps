{
  "expo": {
    "name": "Strago",
    "slug": "three-steps",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "strago",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ff00ff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pubomaxaccess.app",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "Strago needs access to your camera to scan product barcodes and take photos of items you're purchasing.",
        "NSPhotoLibraryUsageDescription": "Strago needs access to your photo library to save product photos.",
        "NSPhotoLibraryAddUsageDescription": "Strago needs permission to save photos of your products.",
        "NSLocationWhenInUseUsageDescription": "Strago uses your location to help track where you shop and provide store-specific insights."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "package": "com.pubomaxaccess.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ff00ff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PHONE_STATE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Strago to access your camera to scan product barcodes and take photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "861641c2-0c45-4b28-a1c9-d037dac499da"
      },
      "router": {}
    },
    "owner": "tbijou",
    "updates": {
      "url": "https://u.expo.dev/861641c2-0c45-4b28-a1c9-d037dac499da"
    }
  }
}
