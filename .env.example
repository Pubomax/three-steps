# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard

# Your Supabase project URL (format: https://xxxxxxxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Your Supabase anonymous/public API key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Go to your Supabase project dashboard
# 3. Navigate to Settings > API
# 4. Copy the "Project URL" and paste it above
# 5. Copy the "anon/public" key and paste it above
# 6. Save the .env file
# 7. Restart your development server
