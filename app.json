{
  "expo": {
    "name": "Three Steps",
    "slug": "three-steps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "threesteps",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10b981"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threesteps.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Three Steps needs access to your camera to scan product barcodes and take photos of items you're purchasing.",
        "NSPhotoLibraryUsageDescription": "Three Steps needs access to your photo library to save product photos.",
        "NSPhotoLibraryAddUsageDescription": "Three Steps needs permission to save photos of your products.",
        "NSLocationWhenInUseUsageDescription": "Three Steps uses your location to help track where you shop and provide store-specific insights."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.threesteps.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#10b981"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Three Steps to access your camera to scan product barcodes and take photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "861641c2-0c45-4b28-a1c9-d037dac499da"
      },
      "router": {}
    },
    "owner": "tbijou"
  }
}
